# APK de l'app mobile : bon type MIME → Android propose l'installation,
# desktop télécharge. Fichier optionnel dans downloads/ (voir tools/MOBILE_APK_DISTRIBUTION.md).
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>

# Activer la réécriture d'URL
RewriteEngine On

# CRITIQUE : forwarder le header Authorization à PHP
# Sans cette ligne, Apache supprime Authorization et PHP reçoit un token vide → 401
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Laisser passer les fichiers et dossiers existants (assets CSS/JS/images)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste → index.php
RewriteRule ^ index.php [QSA,L]